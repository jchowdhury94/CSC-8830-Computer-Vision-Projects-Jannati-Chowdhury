# Virtual environment
.venv/

# Python cache and build artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/

# macOS and editors
.DS_Store
.vscode/
.idea/

# Local Streamlit cache (if present)
.streamlit/cache/

# SAM2 weights and interrupted runtime downloads never belong in Git.
sam2.1_hiera_tiny.pt
sam2.1_hiera_tiny.pt.*.part

# Module 6 raw inputs and original renderings stay local.
/Modules/Module_6/Part_A/input/video_1_horizontal.MOV
/Modules/Module_6/Part_A/input/video_2_diagonal.MOV
/Modules/Module_6/Part_A/output/video_1_optical_flow.mp4
/Modules/Module_6/Part_A/output/video_2_optical_flow.mp4

# Module 6 Part B high-resolution source/intermediate images stay local.
# Keep combined figures, scripts, and numerical assignment evidence in Git.
/Modules/Module_6/Part_B/input/IMG_7596.jpeg
/Modules/Module_6/Part_B/input/IMG_7597.jpeg
/Modules/Module_6/Part_B/input/IMG_7598.jpeg
/Modules/Module_6/Part_B/input/IMG_7603.jpeg
/Modules/Module_6/Part_B/working/view_1_upright.png
/Modules/Module_6/Part_B/working/view_2_upright.png
/Modules/Module_6/Part_B/working/view_3_upright.png
/Modules/Module_6/Part_B/working/view_4_upright.png
/Modules/Module_6/Part_B/output/view_1_correspondences.png
/Modules/Module_6/Part_B/output/view_2_correspondences.png
/Modules/Module_6/Part_B/output/view_3_correspondences.png
/Modules/Module_6/Part_B/output/view_4_correspondences.png

# Module 7 stereo images stay local. Keep scripts, coordinate CSVs, and summary CSVs in Git.
/Modules/Module_7/data/calibration/left/*.jpeg
/Modules/Module_7/data/calibration/right/*.jpeg
/Modules/Module_7/results/corner_detection/*.jpg
/Modules/Module_7/results/stage1_5_validation/*.jpg

# Module 7 original object photographs stay local (about 22 MB). The app runs from the smaller
# Module_7/display/ images, selections/ and outputs/, which stay in Git.
/Modules/Module_7/data/object_measurement/left/*.jpeg
/Modules/Module_7/data/object_measurement/right/*.jpeg
